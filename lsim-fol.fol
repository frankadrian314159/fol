;;; Discrete Event Simulator in FOL
;;; Uses persistent data structures

;;; ===========================================================================
;;; Component and Event Constructors
;;; ===========================================================================

(defn make-component [name inputs outputs connections delays logic-fn]
  {:name name
   :inputs inputs
   :outputs outputs
   :connections connections
   :delays delays
   :logic-fn logic-fn})

(defn make-event [time node value]
  {:time time
   :node node
   :value value})

;;; ===========================================================================
;;; Component Logic
;;; ===========================================================================

(defn get-input-states [comp node-values]
  (bind [connections (:connections comp)
        inputs (:inputs comp)]
    (loop [ports inputs
           result {}]
      (if (empty? ports)
        result
        (bind [port (first ports)
              node (get connections port)
              value (get node-values node)]
          (recur (rest ports)
                 (assoc result port value)))))))

(defn find-max-delay [delays changed-ports out-port]
  (loop [ports changed-ports
         max-delay 0]
    (if (empty? ports)
      max-delay
      (bind [in-port (first ports)
            port-delays (get delays in-port)]
        (if port-delays
          (bind [delay (get port-delays out-port)]
            (recur (rest ports)
                   (if (and delay (> delay max-delay))
                     delay
                     max-delay)))
          (recur (rest ports) max-delay))))))

(defn compute-next-state [comp input-states changed-ports]
  (bind [logic-fn (:logic-fn comp)
        delays (:delays comp)
        outputs (:outputs comp)
        new-states (logic-fn input-states)]
    (loop [out-ports outputs
           results []]
      (if (empty? out-ports)
        results
        (bind [out-port (first out-ports)
              max-delay (find-max-delay delays changed-ports out-port)]
          (recur (rest out-ports)
                 (conj results {:port out-port
                               :value (get new-states out-port)
                               :delay max-delay})))))))

;;; ===========================================================================
;;; Connectivity
;;; ===========================================================================

(defn register-connectivity [comp connectivity-map]
  (bind [connections (:connections comp)
        inputs (:inputs comp)]
    (loop [ports inputs
           conn-map connectivity-map]
      (if (empty? ports)
        conn-map
        (bind [port (first ports)
              node (get connections port)
              existing (get conn-map node [])]
          (recur (rest ports)
                 (assoc conn-map node (conj existing comp))))))))

(defn build-connectivity [netlist]
  (loop [components netlist
         conn-map {}]
    (if (empty? components)
      conn-map
      (recur (rest components)
             (register-connectivity (first components) conn-map)))))

;;; ===========================================================================
;;; Priority Queue using priority-dict
;;; ===========================================================================

(defn queue-empty []
  {:pdict (make '<priority-dict>)
   :counter 0
   :events {}})

(defn queue-insert [queue event]
  (bind [counter (:counter queue)
        pdict (:pdict queue)
        events (:events queue)
        evt-time (:time event)
        new-pdict (conj pdict (cons counter evt-time))
        new-events (assoc events counter event)]
    {:pdict new-pdict
     :counter (+ counter 1)
     :events new-events}))

(defn queue-peek [queue]
  (bind [pdict (:pdict queue)
        events (:events queue)
        min-entry (priority-dict-peek-min pdict)]
    (if min-entry
      (bind [key (first min-entry)]
        (get events key))
      nil)))

(defn queue-pop [queue]
  (bind [pdict (:pdict queue)
        events (:events queue)
        min-entry (priority-dict-peek-min pdict)]
    (if min-entry
      (bind [key (first min-entry)
            new-pdict (priority-dict-pop-min pdict)
            new-events (dissoc events key)]
        {:pdict new-pdict
         :counter (:counter queue)
         :events new-events})
      queue)))

(defn queue-empty? [queue]
  (zero? (size (:pdict queue))))

;;; ===========================================================================
;;; Main Simulation Loop
;;; ===========================================================================

(defn run-simulation [netlist initial-events max-time monitored-nodes]
  (bind [connectivity (build-connectivity netlist)]
    (loop [queue (loop [events initial-events
                       q (queue-empty)]
                  (if (empty? events)
                    q
                    (recur (rest events)
                           (queue-insert q (first events)))))
           node-values {}
           event-history {}
           current-time 0]
      (if (or (queue-empty? queue) (> current-time max-time))
        event-history
        (bind [first-event (queue-peek queue)
              event-time (:time first-event)
              ;; Extract batch at same time - returns [queue-after-extraction batch]
              extraction-result
              (loop [q queue
                     batch []]
                (bind [peek-evt (queue-peek q)]
                  (if (or (not peek-evt) (not (= (:time peek-evt) event-time)))
                    [q batch]  ;; Done extracting, return queue and batch
                    (recur (queue-pop q) (conj batch peek-evt)))))
              remaining-queue (first extraction-result)
              batch (first (rest extraction-result))]
          ;; Process batch
          (bind [;; Update node values
                    new-node-values
                    (loop [events batch
                           nv node-values]
                      (if (empty? events)
                        nv
                        (bind [evt (first events)]
                          (recur (rest events)
                                 (assoc nv (:node evt) (:value evt))))))

                    ;; Update event history
                    new-event-history
                    (loop [events batch
                           eh event-history]
                      (if (empty? events)
                        eh
                        (bind [evt (first events)
                              node (:node evt)]
                          (if (get monitored-nodes node)
                            (bind [existing (get eh node [])]
                              (recur (rest events)
                                     (assoc eh node (conj existing evt))))
                            (recur (rest events) eh)))))

                    ;; Build changed nodes set
                    changed-nodes
                    (loop [events batch
                           nodes #{}]
                      (if (empty? events)
                        nodes
                        (recur (rest events)
                               (conj nodes (:node (first events))))))

                    ;; Find affected components
                    affected-comps
                    (loop [nodes changed-nodes
                           comps #{}]
                      (if (empty? nodes)
                        comps
                        (bind [node (first nodes)
                              node-comps (get connectivity node [])]
                          (recur (rest nodes)
                                 (loop [nc node-comps
                                       c comps]
                                   (if (empty? nc)
                                     c
                                     (recur (rest nc)
                                            (conj c (first nc)))))))))

                    ;; Generate new events and insert into remaining queue
                    final-queue
                    (loop [components affected-comps
                           q remaining-queue]
                      (if (empty? components)
                        q
                        (bind [comp (first components)
                              input-states (get-input-states comp new-node-values)
                              connections (:connections comp)
                              inputs (:inputs comp)
                              changed-ports
                              (loop [ports inputs
                                    cports []]
                                (if (empty? ports)
                                  cports
                                  (bind [port (first ports)
                                        node (get connections port)]
                                    (if (get changed-nodes node)
                                      (recur (rest ports) (conj cports port))
                                      (recur (rest ports) cports)))))
                              results (compute-next-state comp input-states changed-ports)]
                          (recur (rest components)
                                 (loop [res results
                                       q2 q]
                                   (if (empty? res)
                                     q2
                                     (bind [r (first res)
                                           conn (:connections comp)
                                           new-evt (make-event
                                                    (+ event-time (:delay r))
                                                    (get conn (:port r))
                                                    (:value r))]
                                       (recur (rest res)
                                              (queue-insert q2 new-evt)))))))))]
            (recur final-queue new-node-values new-event-history event-time)))))))

;;; ===========================================================================
;;; Gate Components
;;; ===========================================================================

(defn make-nand-gate [name in1-node in2-node out-node]
  (make-component
   name
   [:in1 :in2]
   [:out]
   {:in1 in1-node :in2 in2-node :out out-node}
   {:in1 {:out 1} :in2 {:out 1}}
   (fn [inputs]
     {:out (not (and (:in1 inputs) (:in2 inputs)))})))

(defn make-not-gate [name in-node out-node]
  (make-component
   name
   [:in]
   [:out]
   {:in in-node :out out-node}
   {:in {:out 1}}
   (fn [inputs]
     {:out (not (:in inputs))})))

(defn make-d-latch-from-gates [name-prefix clk-node d-node q-node]
  (bind [d-not (keyword (str name-prefix "-D-NOT"))
        s (keyword (str name-prefix "-S"))
        r (keyword (str name-prefix "-R"))
        q-not (keyword (str name-prefix "-Q-NOT"))]
    [(make-not-gate (keyword (str name-prefix "-NOT-D")) d-node d-not)
     (make-nand-gate (keyword (str name-prefix "-NAND-S")) d-node clk-node s)
     (make-nand-gate (keyword (str name-prefix "-NAND-R")) d-not clk-node r)
     (make-nand-gate (keyword (str name-prefix "-NAND-Q")) s q-not q-node)
     (make-nand-gate (keyword (str name-prefix "-NAND-Q-NOT")) r q-node q-not)]))

(defn make-nbit-register-from-gates [n]
  (loop [i 0
         components []]
    (if (>= i n)
      components
      (bind [latch-name (str "LATCH" i)
            d-node (keyword (str "IN" i))
            q-node (keyword (str "OUT" i))
            gates (make-d-latch-from-gates latch-name :clk d-node q-node)]
        (recur (+ i 1)
               (loop [g gates
                      c components]
                 (if (empty? g)
                   c
                   (recur (rest g) (conj c (first g))))))))))

;;; ===========================================================================
;;; Test Event Generation
;;; ===========================================================================

(defn make-test-events [n-bits max-time]
  (bind [;; Initial values
        initial
        (loop [i 0
               events []]
          (if (>= i n-bits)
            events
            (recur (+ i 1)
                   (conj events (make-event 0
                                           (keyword (str "IN" i))
                                           (odd? i))))))

        ;; Clock and data events
        timed
        (loop [time 10
               events []]
          (if (>= time max-time)
            events
            (bind [pattern (if (zerop (mod time 100)) #xAAAAAAAA #x55555555)
                  clk-events [(make-event time :clk true)
                             (make-event (+ time 5) :clk false)]
                  data-events
                  (if (zero? (mod time 50))
                    (loop [i 0
                           de []]
                      (if (>= i n-bits)
                        de
                        (recur (+ i 1)
                               (conj de (make-event
                                        (+ time 2)
                                        (keyword (str "IN" i))
                                        (bit-test pattern i))))))
                    [])]
              (recur (+ time 10)
                     (loop [ce clk-events
                            ev events]
                       (if (empty? ce)
                         (loop [de data-events
                                ev2 ev]
                           (if (empty? de)
                             ev2
                             (recur (rest de) (conj ev2 (first de)))))
                         (recur (rest ce) (conj ev (first ce)))))))))]

    (loop [te timed
           ie initial]
      (if (empty? te)
        ie
        (recur (rest te) (conj ie (first te)))))))
