;; String/concat operators - zero elimination
(defmethod ast-optimize-fast [(<op-concat> node)]
  (bind [l (slot-value node 'left)
         r (slot-value node 'right)]
    (cond
      ((and (typep l '<op-lit>) (= (slot-value l 'val) 0)) r)
