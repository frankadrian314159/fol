;; Default fallback (shouldn't be reached if all node types are covered)
(defmethod ast-optimize-fast [(node <ast-node>)] node)

;; Keep old interface for compatibility, but alias to fast version
(defgeneric ast-optimize [node])
(defmethod ast-optimize [(node <ast-node>)] (ast-optimize-fast node))

;; ---- OPTIMIZED: Simple type-based walk dispatch (no destructuring) ----
;;
;; This walk function uses direct slot access instead of :keys destructuring.
;; Combined with optimized ast-optimize-fast, this reduces the overall
;; node processing overhead significantly.

(defgeneric walk-node [node]
  (:documentation "Optimized AST walk using type-based dispatch"))

;; Leaf nodes - return as-is
(defmethod walk-node [(<op-lit> node)] node)
(defmethod walk-node [(<op-var> node)] node)

;; BINARY OPERATOR NODES - recursively walk children, then optimize
(defmethod walk-node [(<op-add> node)]
  (ast-optimize (make-<op-add>
    :left (walk-node (slot-value node 'left))
    :right (walk-node (slot-value node 'right)))))

(defmethod walk-node [(<op-sub> node)]
  (ast-optimize (make-<op-sub>
    :left (walk-node (slot-value node 'left))
    :right (walk-node (slot-value node 'right)))))

(defmethod walk-node [(<op-mul> node)]
  (ast-optimize (make-<op-mul>
    :left (walk-node (slot-value node 'left))
    :right (walk-node (slot-value node 'right)))))

(defmethod walk-node [(<op-div> node)]
  (ast-optimize (make-<op-div>
    :left (walk-node (slot-value node 'left))
    :right (walk-node (slot-value node 'right)))))

(defmethod walk-node [(<op-rem> node)]
  (ast-optimize (make-<op-rem>
    :left (walk-node (slot-value node 'left))
    :right (walk-node (slot-value node 'right)))))

(defmethod walk-node [(<op-pow> node)]
  (ast-optimize (make-<op-pow>
    :left (walk-node (slot-value node 'left))
    :right (walk-node (slot-value node 'right)))))

(defmethod walk-node [(<op-band> node)]
  (ast-optimize (make-<op-band>
    :left (walk-node (slot-value node 'left))
    :right (walk-node (slot-value node 'right)))))

(defmethod walk-node [(<op-bor> node)]
  (ast-optimize (make-<op-bor>
    :left (walk-node (slot-value node 'left))
    :right (walk-node (slot-value node 'right)))))

(defmethod walk-node [(<op-bxor> node)]
  (ast-optimize (make-<op-bxor>
    :left (walk-node (slot-value node 'left))
    :right (walk-node (slot-value node 'right)))))

(defmethod walk-node [(<op-shl> node)]
  (ast-optimize (make-<op-shl>
    :left (walk-node (slot-value node 'left))
    :right (walk-node (slot-value node 'right)))))

(defmethod walk-node [(<op-shr> node)]
  (ast-optimize (make-<op-shr>
    :left (walk-node (slot-value node 'left))
    :right (walk-node (slot-value node 'right)))))

(defmethod walk-node [(<op-eq> node)]
  (ast-optimize (make-<op-eq>
    :left (walk-node (slot-value node 'left))
    :right (walk-node (slot-value node 'right)))))

(defmethod walk-node [(<op-neq> node)]
  (ast-optimize (make-<op-neq>
    :left (walk-node (slot-value node 'left))
    :right (walk-node (slot-value node 'right)))))

(defmethod walk-node [(<op-lt> node)]
  (ast-optimize (make-<op-lt>
    :left (walk-node (slot-value node 'left))
    :right (walk-node (slot-value node 'right)))))

(defmethod walk-node [(<op-gt> node)]
  (ast-optimize (make-<op-gt>
    :left (walk-node (slot-value node 'left))
    :right (walk-node (slot-value node 'right)))))

(defmethod walk-node [(<op-le> node)]
  (ast-optimize (make-<op-le>
    :left (walk-node (slot-value node 'left))
    :right (walk-node (slot-value node 'right)))))

(defmethod walk-node [(<op-ge> node)]
  (ast-optimize (make-<op-ge>
    :left (walk-node (slot-value node 'left))
    :right (walk-node (slot-value node 'right)))))

(defmethod walk-node [(<op-and> node)]
  (ast-optimize (make-<op-and>
    :left (walk-node (slot-value node 'left))
    :right (walk-node (slot-value node 'right)))))

(defmethod walk-node [(<op-or> node)]
  (ast-optimize (make-<op-or>
    :left (walk-node (slot-value node 'left))
    :right (walk-node (slot-value node 'right)))))

(defmethod walk-node [(<op-concat> node)]
  (ast-optimize (make-<op-concat>
    :left (walk-node (slot-value node 'left))
    :right (walk-node (slot-value node 'right)))))

(defmethod walk-node [(<op-split> node)]
  (ast-optimize (make-<op-split>
    :left (walk-node (slot-value node 'left))
    :right (walk-node (slot-value node 'right)))))

(defmethod walk-node [(<op-join> node)]
  (ast-optimize (make-<op-join>
    :left (walk-node (slot-value node 'left))
    :right (walk-node (slot-value node 'right)))))

(defmethod walk-node [(<op-map> node)]
  (ast-optimize (make-<op-map>
    :left (walk-node (slot-value node 'left))
    :right (walk-node (slot-value node 'right)))))

;; Keep old interface for compatibility
(defgeneric walk [node])
(defmethod walk [(node <ast-node>)] (walk-node node))
  ([({:keys [(left l) (right r)]} <op-bxor>)]   (ast-optimize (make-<op-bxor>   :left (walk l) :right (walk r))))
  ([({:keys [(left l) (right r)]} <op-shl>)]    (ast-optimize (make-<op-shl>    :left (walk l) :right (walk r))))
  ([({:keys [(left l) (right r)]} <op-shr>)]    (ast-optimize (make-<op-shr>    :left (walk l) :right (walk r))))
  ([({:keys [(left l) (right r)]} <op-eq>)]     (ast-optimize (make-<op-eq>     :left (walk l) :right (walk r))))
  ([({:keys [(left l) (right r)]} <op-neq>)]    (ast-optimize (make-<op-neq>    :left (walk l) :right (walk r))))
  ([({:keys [(left l) (right r)]} <op-lt>)]     (ast-optimize (make-<op-lt>     :left (walk l) :right (walk r))))
  ([({:keys [(left l) (right r)]} <op-gt>)]     (ast-optimize (make-<op-gt>     :left (walk l) :right (walk r))))
  ([({:keys [(left l) (right r)]} <op-le>)]     (ast-optimize (make-<op-le>     :left (walk l) :right (walk r))))
  ([({:keys [(left l) (right r)]} <op-ge>)]     (ast-optimize (make-<op-ge>     :left (walk l) :right (walk r))))
  ([({:keys [(left l) (right r)]} <op-and>)]    (ast-optimize (make-<op-and>    :left (walk l) :right (walk r))))
  ([({:keys [(left l) (right r)]} <op-or>)]     (ast-optimize (make-<op-or>     :left (walk l) :right (walk r))))
  ([({:keys [(left l) (right r)]} <op-concat>)] (ast-optimize (make-<op-concat> :left (walk l) :right (walk r))))
  ([({:keys [(left l) (right r)]} <op-split>)]  (ast-optimize (make-<op-split>  :left (walk l) :right (walk r))))
  ([({:keys [(left l) (right r)]} <op-join>)]   (ast-optimize (make-<op-join>   :left (walk l) :right (walk r))))
  ([({:keys [(left l) (right r)]} <op-map>)]    (ast-optimize (make-<op-map>    :left (walk l) :right (walk r))))
  ([n] n))

;; ---- Balanced-tree builder ----
;;
;; make-op: selects one of the 23 binary operator constructors by (idx mod 23).
;; FOL cond uses Lisp-style (condition body) pairs, not flat alternating tokens.
(defn make-op [idx left right]
  (bind [k (mod idx 23)]
    (cond
      ((= k 0)  (make-<op-add>    :left left :right right))
      ((= k 1)  (make-<op-sub>    :left left :right right))
      ((= k 2)  (make-<op-mul>    :left left :right right))
      ((= k 3)  (make-<op-div>    :left left :right right))
      ((= k 4)  (make-<op-rem>    :left left :right right))
      ((= k 5)  (make-<op-pow>    :left left :right right))
      ((= k 6)  (make-<op-band>   :left left :right right))
      ((= k 7)  (make-<op-bor>    :left left :right right))
      ((= k 8)  (make-<op-bxor>   :left left :right right))
      ((= k 9)  (make-<op-shl>    :left left :right right))
      ((= k 10) (make-<op-shr>    :left left :right right))
      ((= k 11) (make-<op-eq>     :left left :right right))
      ((= k 12) (make-<op-neq>    :left left :right right))
      ((= k 13) (make-<op-lt>     :left left :right right))
      ((= k 14) (make-<op-gt>     :left left :right right))
      ((= k 15) (make-<op-le>     :left left :right right))
      ((= k 16) (make-<op-ge>     :left left :right right))
      ((= k 17) (make-<op-and>    :left left :right right))
      ((= k 18) (make-<op-or>     :left left :right right))
      ((= k 19) (make-<op-concat> :left left :right right))
      ((= k 20) (make-<op-split>  :left left :right right))
      ((= k 21) (make-<op-join>   :left left :right right))
      ((= k 22) (make-<op-map>    :left left :right right)))))

;; make-leaf: cycles op-lit(0), op-lit(1), op-var(:x)
(defn make-leaf [idx]
  (bind [k (mod idx 3)]
    (cond
      ((= k 0) (make-<op-lit> :val 0))
      ((= k 1) (make-<op-lit> :val 1))
      ((= k 2) (make-<op-var> :name :x)))))

;; build-balanced: builds a tree with exactly n nodes.
;; Precondition: n is odd so (n-1)/2 is exact integer division.
;; Produces a near-perfect balanced binary tree of depth ceil(log2 n) = 13 for n=9999.
(defn build-balanced [n idx]
  (if (<= n 1)
    (make-leaf idx)
    (bind [half (/ (- n 1) 2)]
      (make-op idx
        (build-balanced half       (* 2 idx))
        (build-balanced half (+ (* 2 idx) 1))))))

;; run-bench: builds the 9,999-node tree once then runs n optimizer passes.
(defn run-bench [n]
  (bind [tree (build-balanced 9999 1)]
    (dotimes [i n]
      (walk tree))))
