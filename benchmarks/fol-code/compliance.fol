;;; =============================================================================
;;; Compliance Module - Trade validation
;;; =============================================================================

(in-package "compliance"
  (:export <trade> validate-trade trade-symbol trade-amount trade-price trade-side))

;; 1. Define the Trade class
(defclass <trade> []
  [[symbol :initarg :symbol :accessor trade-symbol]
   [amount :initarg :amount :accessor trade-amount]
   [price  :initarg :price  :accessor trade-price]
   [side   :initarg :side   :accessor trade-side]])

(defn trade-total-price [trade]
  (* (trade-price trade) (trade-amount trade)))

;; 2. Define custom predicates
(defn restricted-symbol? [trade]
  (contains? #{:AMZN :GOOG :META :MSFT} (trade-symbol trade)))

(defn high-value? [trade]
  (> (trade-total-price trade) 1000000.00))

(defn is-buy-side-trade? [trade]
  (= (trade-side trade) :buy))

(defn is-penny-stock? [trade]
  (< (trade-price trade) 5.00))

(defn penny-stock-buy? [trade]
  (and (is-buy-side-trade? trade) (is-penny-stock? trade)))

(defn validate-trade [trd]
  (cond
    ((restricted-symbol? trd)
     {:status :rejected :reason (str "Symbol " (trade-symbol trd) " is on the restricted list")})
    ((high-value? trd)
     {:status :manual-review :reason "Trade value exceeds $1M limit"})
    ((penny-stock-buy? trd)
     {:status :warning :reason "High risk penny stock purchase" :trade trd})
    (:else {:status :approved :id (gensym "TRD")}) ))

;;; =============================================================================
;;; Test Module
;;; =============================================================================

(in-package "test-compliance"
  (:use "cl" "compliance"))

(defn compliance []
  ;; Create test trades
  (bind [t1 (make '<trade> :symbol :NU :amount 100 :price 18.00 :side :buy)
         t2 (make '<trade> :symbol :GOOG :amount 50 :price 150.00 :side :sell)
         t3 (make '<trade> :symbol :IBM  :amount 10000 :price 150.00 :side :buy)
         t4 (make '<trade> :symbol :F :amount 1000 :price 12.00 :side :buy)]

    ;; Run tests
    (println (str "T1: " (validate-trade t1)))
    (println (str "T2: " (validate-trade t2)))
    (println (str "T3: " (validate-trade t3)))
    (println (str "T4: " (validate-trade t4)))))

(defn run-bench []
  (bind [t1 (make '<trade> :symbol :NU :amount 100 :price 18.00 :side :buy)
         t2 (make '<trade> :symbol :GOOG :amount 50 :price 150.00 :side :sell)
         t3 (make '<trade> :symbol :IBM  :amount 10000 :price 150.00 :side :buy)
         t4 (make '<trade> :symbol :F :amount 1000 :price 12.00 :side :buy)]
    (loop [i 0]
      (if (< i 1000)
          (do (validate-trade t1)
              (validate-trade t2)
              (validate-trade t3)
              (validate-trade t4)
              (recur (+ i 1)))))))
