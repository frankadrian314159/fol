;;; Simplified Discrete Event Simulator in FOL
;;; Uses priority-dict queue - avoids nested recur issues

(defn make-component [name inputs outputs connections delays logic-fn]
  {:name name :inputs inputs :outputs outputs
   :connections connections :delays delays :logic-fn logic-fn})

(defn make-event [time node value]
  {:time time :node node :value value})

(defn make-nand-gate [name in1-node in2-node out-node]
  (make-component name [:in1 :in2] [:out]
   {:in1 in1-node :in2 in2-node :out out-node}
   {:in1 {:out 1} :in2 {:out 1}}
   (fn [inputs] {:out (not (and (:in1 inputs) (:in2 inputs)))})))

(defn make-not-gate [name in-node out-node]
  (make-component name [:in] [:out]
   {:in in-node :out out-node}
   {:in {:out 1}}
   (fn [inputs] {:out (not (:in inputs))})))

(defn make-d-latch-from-gates [name-prefix clk-node d-node q-node]
  (bind [d-not (keyword (str name-prefix "-D-NOT"))
        s (keyword (str name-prefix "-S"))
        r (keyword (str name-prefix "-R"))
        q-not (keyword (str name-prefix "-Q-NOT"))]
    [(make-not-gate (keyword (str name-prefix "-NOT-D")) d-node d-not)
     (make-nand-gate (keyword (str name-prefix "-NAND-S")) d-node clk-node s)
     (make-nand-gate (keyword (str name-prefix "-NAND-R")) d-not clk-node r)
     (make-nand-gate (keyword (str name-prefix "-NAND-Q")) s q-not q-node)
     (make-nand-gate (keyword (str name-prefix "-NAND-Q-NOT")) r q-node q-not)]))

(defn make-nbit-register-from-gates [n]
  (loop [i 0 components []]
    (if (>= i n)
      components
      (bind [latch-name (str "LATCH" i)
            gates (make-d-latch-from-gates latch-name :clk
                    (keyword (str "IN" i)) (keyword (str "OUT" i)))]
        (recur (+ i 1)
               (loop [g gates c components]
                 (if (empty? g)
                   c
                   (recur (rest g) (conj c (first g))))))))))

(defn make-test-events [n-bits max-time]
  (bind [initial
        (loop [i 0 events []]
          (if (>= i n-bits)
            events
            (recur (+ i 1)
                   (conj events (make-event 0 (keyword (str "IN" i)) (odd? i))))))
        timed
        (loop [time 10 events []]
          (if (>= time max-time)
            events
            (bind [pattern (if (zerop (mod time 100)) #xAAAAAAAA #x55555555)
                  clk-events [(make-event time :clk true)
                             (make-event (+ time 5) :clk false)]
                  data-events
                  (if (zero? (mod time 50))
                    (loop [i 0 de []]
                      (if (>= i n-bits)
                        de
                        (recur (+ i 1)
                               (conj de (make-event (+ time 2)
                                        (keyword (str "IN" i))
                                        (bit-test pattern i))))))
                    [])]
              (recur (+ time 10)
                     (loop [ce clk-events ev events]
                       (if (empty? ce)
                         (loop [de data-events ev2 ev]
                           (if (empty? de)
                             ev2
                             (recur (rest de) (conj ev2 (first de)))))
                         (recur (rest ce) (conj ev (first ce)))))))))]
    (loop [te timed ie initial]
      (if (empty? te)
        ie
        (recur (rest te) (conj ie (first te)))))))

;;; Simplified queue ops
(defn queue-empty []
  {:pdict (make '<priority-dict>) :counter 0 :events {}})

(defn queue-insert [queue event]
  {:pdict (conj (:pdict queue) (cons (:counter queue) (:time event)))
   :counter (+ (:counter queue) 1)
   :events (assoc (:events queue) (:counter queue) event)})

(defn queue-peek [queue]
  (bind [min-entry (priority-dict-peek-min (:pdict queue))]
    (if min-entry
      (get (:events queue) (first min-entry))
      nil)))

(defn queue-pop [queue]
  (bind [min-entry (priority-dict-peek-min (:pdict queue))]
    (if min-entry
      {:pdict (priority-dict-pop-min (:pdict queue))
       :counter (:counter queue)
       :events (dissoc (:events queue) (first min-entry))}
      queue)))

(defn queue-empty? [queue]
  (zero? (size (:pdict queue))))

;;; Simplified simulation - single event at a time (no batching)
(defn run-simulation [netlist initial-events max-time monitored-nodes]
  (loop [queue (loop [events initial-events q (queue-empty)]
                (if (empty? events)
                  q
                  (recur (rest events) (queue-insert q (first events)))))
         node-values {}
         event-history {}]
    (if (queue-empty? queue)
      event-history
      (bind [event (queue-peek queue)
            event-time (:time event)]
        (if (> event-time max-time)
          event-history
          (bind [new-node-values (assoc node-values (:node event) (:value event))
                new-event-history
                (if (get monitored-nodes (:node event))
                  (bind [existing (get event-history (:node event) [])]
                    (assoc event-history (:node event) (conj existing event)))
                  event-history)]
            ;; For simplicity: just return history without component processing
            (recur (queue-pop queue) new-node-values new-event-history)))))))