;;; Core Functions Tests

;;; Collections
(assert (= (count [1 2 3]) 3) "count vector")
(assert (= (get {:a 1} :a) 1) "get dict")
(assert (= (conj [1 2] 3) [1 2 3]) "conj vector")
(assert (= (conj #{1 2} 3) #{1 2 3}) "conj set")

;;; Arithmetic
(assert (= (+ 1 2 3) 6) "+ multiple")
(assert (= (- 10 3 2) 5) "- multiple")
(assert (= (* 2 3 4) 24) "* multiple")
(assert (= (/ 10 2) 5) "/ simple")

;;; Comparison
(assert (< 1 2 3) "< multiple")
(assert (> 3 2 1) "> multiple")
(assert (<= 1 1 2) "<= multiple")
(assert (>= 2 1 1) ">= multiple")
(assert (= 1 1 1) "= multiple")
(assert (/= 1 2 3) "/= multiple")

;;; Sequence functions
(assert (= (map inc [1 2 3]) [2 3 4]) "map inc")
(assert (= (filter odd? [1 2 3 4 5]) [1 3 5]) "filter odd?")
(assert (= (reduce + 0 [1 2 3 4]) 10) "reduce +")

;;; Logical functions
(assert (and true true) "and true true")
(assert (not (and true false)) "and true false")
(assert (or true false) "or true false")
(assert (not (or false false)) "or false false")
